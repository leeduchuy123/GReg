# Google Drive layout for the vast.ai scripts (sourced by fetch_data.sh and sync_loop.sh).
# Every path is relative to the shared project folder, addressed by ID so the rclone remote keeps its default root:
#   https://drive.google.com/drive/folders/1FTgmwzFrRW9qIzLNYAFmt9txxECPgsTr
GDRIVE_REMOTE=${GDRIVE_REMOTE:-gdrive}
GDRIVE_FOLDER_ID=${GDRIVE_FOLDER_ID:-1FTgmwzFrRW9qIzLNYAFmt9txxECPgsTr}
DRIVE="${GDRIVE_REMOTE},root_folder_id=${GDRIVE_FOLDER_ID}:"

# inputs
DRIVE_PKLS="HamNoSys subset with optimized shape/hamnosys_pkls_cropFalse_shapeTrue"  # holds hamnosys_pkls_cropFalse_shapeTrue/*.pkl
DRIVE_VIDEOS="HamNoSys videos"                                                        # *.mp4
DRIVE_SMPLX="models_smplx_v1_1"                                                       # models/smplx/SMPLX_*.npz
# outputs: <DRIVE_RUNS>/<RUN_NAME>/{outputs,logs,state}, or exactly the folder DRIVE_DEST_DIR when it is set
# (e.g. DRIVE_DEST_DIR=Greg-run-mesh-flow-regions-improvment keeps a run apart from GReg_runs/)
DRIVE_RUNS=${DRIVE_RUNS:-GReg_runs}
DRIVE_DEST_DIR=${DRIVE_DEST_DIR:-}
